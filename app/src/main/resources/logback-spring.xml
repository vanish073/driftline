<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging with personal data masked in every message and stack trace (DESIGN §14, D77). -->
<configuration>
    <conversionRule conversionWord="maskedMsg" class="io.github.vanish073.driftline.app.pii.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedEx" class="io.github.vanish073.driftline.app.pii.MaskingThrowableConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %5p [%15.15t] %-40.40logger{39} : %maskedMsg%n%maskedEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
